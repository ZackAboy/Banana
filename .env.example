# Explicit synthetic demo. No API credentials needed.
USE_MOCK_SERVICES=true
# Server-only. Never prefix these with NEXT_PUBLIC_.
# Default live identification: local OCR + uploaded Lens + Search + deterministic Fusion.
IDENTIFICATION_MODE=evidence
# Absolute executable in an already provisioned PaddleOCR Python 3.11 environment.
OCR_PYTHON=
# Bounded local CLI runtime (1000–180000 milliseconds).
OCR_TIMEOUT_MS=60000
# Gemini is optional fallback; set both key and vision model to enable it.
# IDENTIFICATION_MODE=gemini explicitly selects the legacy Gemini-only path.
GEMINI_API_KEY=
# Required for live external product evidence and direct temporary Lens uploads.
# Images are sent to SerpApi; no public image hosting is required. Server-only.
SERPAPI_API_KEY=
# Examples only; check availability/free-tier limits for your account.
GEMINI_VISION_MODEL=gemini-2.5-flash
# Reserved for later review analysis; not required for identification.
GEMINI_TEXT_MODEL=gemini-2.5-flash
